---
interface Props {
  kind?: 'ok' | 'bad' | 'neutral';
}
const { kind = 'neutral' } = Astro.props;
const hint =
  kind === 'ok'
    ? 'Esempi corretti - coppie Mobile / Desktop o Corretto'
    : kind === 'bad'
      ? 'Anti-pattern - da marcare come Errato'
      : 'Wireframe';
---

<figure class={`vh-figure vh-figure--${kind}`}>
  <div class="vh-figure__box">
    <span class="vh-figure__tag">{hint}</span>
    <span class="vh-figure__label"><slot>Wireframe da inserire (Claude Design)</slot></span>
  </div>
</figure>

<style>
  .vh-figure {
    margin: 1.5rem 0 2rem;
  }
  .vh-figure__box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 240px;
    padding: 2rem;
    text-align: center;
    border: 2px dashed var(--sl-color-gray-4);
    border-radius: 12px;
    background:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 10px,
        color-mix(in srgb, var(--sl-color-gray-5) 22%, transparent) 10px,
        color-mix(in srgb, var(--sl-color-gray-5) 22%, transparent) 11px
      );
    color: var(--sl-color-gray-2);
  }
  .vh-figure--ok .vh-figure__box {
    border-color: var(--vh-ok);
  }
  .vh-figure--bad .vh-figure__box {
    border-color: var(--vh-bad);
  }
  .vh-figure__tag {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .vh-figure--ok .vh-figure__tag {
    color: var(--vh-ok);
  }
  .vh-figure--bad .vh-figure__tag {
    color: var(--vh-bad);
  }
  .vh-figure__label {
    font-size: 0.95rem;
    color: var(--sl-color-gray-2);
  }
</style>
